{
  "lastChangelogVersion": "0.84.4",
  "theme": "onedark",
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-mcp-adapter@^2.15.0",
    "npm:pi-subagents@^0.38.0",
    "npm:pi-web-access@^0.17.0",
    "npm:@gotgenes/pi-permission-system@$31.0.0",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "worker": {
        "disabled": true
      },
      "piagent-worker": {
        "disabled": true
      }
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-5.3-codex-spark:minimal",
    "openai-codex/gpt-5.4-mini:minimal",
    "openai-codex/gpt-5.4:xhigh",
    "openai-codex/gpt-5.5:high",
    "openai-codex/gpt-5.6-luna:medium",
    "openai-codex/gpt-5.6-terra:high",
    "openai-codex/gpt-5.6-sol:high",
    "openai-codex/*",
    "anthropic/claude-haiku-4-5:low",
    "anthropic/claude-sonnet-4-5:high",
    "anthropic/claude-sonnet-4-6:max",
    "anthropic/claude-sonnet-5:xhigh",
    "anthropic/claude-opus-4-5:xhigh",
    "anthropic/claude-opus-4-6:max",
    "anthropic/claude-opus-4-7:xhigh",
    "anthropic/claude-opus-4-8:xhigh",
    "anthropic/claude-fable-5:xhigh"
  ]
}
