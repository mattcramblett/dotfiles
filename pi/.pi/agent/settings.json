{
  "lastChangelogVersion": "0.84.4",
  "theme": "onedark",
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-mcp-adapter@2.32.1",
    "npm:pi-subagents@0.38.0",
    "npm:pi-web-access@0.17.1",
    "npm:@gotgenes/pi-permission-system@31.0.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:pi-background-tasks@2.4.2",
    "npm:@narumitw/pi-plan-mode@0.56.0"
  ],
