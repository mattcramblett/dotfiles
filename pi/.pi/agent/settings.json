{
  "lastChangelogVersion": "1.1.0",
  "theme": "onedark",
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-subagents@0.77.0",
    "npm:pi-web-access@0.38.0",
    "npm:@gotgenes/pi-permission-system@31.0.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.12.0",
    "npm:pi-background-tasks@2.4.2",
    "npm:@narumitw/pi-plan-mode@0.56.0"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "worker": {
        "disabled": true
      },
      "piagent-worker": {
        "disabled": true
      }
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "gpt-6-terra",
    "gpt-6-luna",
    "gpt-6.1-sol"
  ]
}
