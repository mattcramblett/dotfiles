{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "delta *": "allow",
      "file *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "rg *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "bash -c *": "ask",
      "find *-delete*": "ask",
      "find *-exec*": "ask",
      "find *-execdir*": "ask",
      "cargo publish *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "doas *": "deny",
      "eval *": "deny",
      "gem push *": "deny",
      "git checkout *": "ask",
      "git clean *": "ask",
      "git commit *": "deny",
      "git merge *": "deny",
      "git push *": "deny",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "kubectl delete *": "deny",
      "npm publish *": "deny",
      "pnpm publish *": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "sh -c *": "deny",
      "shred *": "deny",
      "sudo *": "deny",
      "terraform apply *": "deny",
      "terraform destroy *": "deny",
      "unlink *": "deny",
      "yarn publish *": "deny"
    }
  },
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true
}
