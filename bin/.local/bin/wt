#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: wt <branch-name>

Open a local branch in a sibling Git worktree. If it only exists on origin,
create a local tracking branch. Otherwise, create it from the latest
origin/main or origin/master. Then open the worktree in a new tmux window.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi

if [[ -z "${TMUX:-}" ]]; then
  printf 'wt must be run inside tmux.\n' >&2
  exit 1
fi

for command in git tmux; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'wt requires %s.\n' "$command" >&2
    exit 1
  fi
done

worktree_name=$1
if ! git check-ref-format --branch "$worktree_name" >/dev/null 2>&1; then
  printf 'Invalid worktree or branch name: %s\n' "$worktree_name" >&2
  exit 1
fi

if ! common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  printf 'wt must be run inside a Git repository.\n' >&2
  exit 1
fi

repository_dir=$(dirname "$common_dir")
repository_name=$(basename "$repository_dir")
branch_prefix=$(git config --get worktree.branchPrefix || true)
branch_prefix=${branch_prefix:-"mattcramblett/"}
worktree_label=${worktree_name#"$branch_prefix"}
worktree_label=${worktree_label//\//-}
worktree_dir="$(dirname "$repository_dir")/$repository_name-$worktree_label"
window_name="$repository_name-$worktree_label"

if [[ -e "$worktree_dir" ]]; then
  printf 'Worktree path already exists: %s\n' "$worktree_dir" >&2
  exit 1
fi

if git show-ref --verify --quiet "refs/heads/$worktree_name"; then
  worktree_args=("$worktree_dir" "$worktree_name")
else
  if ! git remote get-url origin >/dev/null 2>&1; then
    printf 'The repository does not have an origin remote.\n' >&2
    exit 1
  fi

  git fetch --prune origin

  if git show-ref --verify --quiet "refs/remotes/origin/$worktree_name"; then
    worktree_args=(-b "$worktree_name" --track "$worktree_dir" "origin/$worktree_name")
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    worktree_args=(-b "$worktree_name" "$worktree_dir" origin/main)
  elif git show-ref --verify --quiet refs/remotes/origin/master; then
    worktree_args=(-b "$worktree_name" "$worktree_dir" origin/master)
  else
    printf 'origin does not have a main or master branch.\n' >&2
    exit 1
  fi
fi

git worktree add "${worktree_args[@]}"
tmux new-window -n "$window_name" -c "$worktree_dir"
